{
  "Applications": [
    { "Id": "Git.Git", "Name": "Git" },
    { "Id": "Microsoft.VisualStudioCode", "Name": "Visual Studio Code" },
    { "Id": "7zip.7zip", "Name": "7-Zip" },
    { "Id": "Mozilla.Firefox", "Name": "Firefox" },
    { "Id": "Notepad++.Notepad++", "Name": "Notepad++" },
    { "Id": "Microsoft.PowerToys", "Name": "PowerToys" }
  ],

  "RegistryTweaks": [
    {
      "Description": "Show known file extensions in Explorer",
      "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "Name": "HideFileExt",
      "Value": 0,
      "Type": "DWord"
    },
    {
      "Description": "Show hidden files in Explorer",
      "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "Name": "Hidden",
      "Value": 1,
      "Type": "DWord"
    },
    {
      "Description": "Launch File Explorer to 'This PC' instead of Quick Access",
      "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "Name": "LaunchTo",
      "Value": 1,
      "Type": "DWord"
    },
    {
      "Description": "Enable dark mode for apps",
      "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "Name": "AppsUseLightTheme",
      "Value": 0,
      "Type": "DWord"
    },
    {
      "Description": "Disable Bing/web results in Start Menu search",
      "Path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\Explorer",
      "Name": "DisableSearchBoxSuggestions",
      "Value": 1,
      "Type": "DWord"
    }
  ],

  "PowerSettings": {
    "PowerPlan": "High performance",
    "MonitorTimeoutACMinutes": 15,
    "MonitorTimeoutDCMinutes": 5,
    "SleepTimeoutACMinutes": 30,
    "SleepTimeoutDCMinutes": 15,
    "DisableHibernate": true
  },

  "PrivacyTweaks": [
    {
      "Description": "Disable advertising ID for personalized ads",
      "Path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\AdvertisingInfo",
      "Name": "Enabled",
      "Value": 0,
      "Type": "DWord"
    },
    {
      "Description": "Set diagnostic data collection to Basic/Required",
      "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "Name": "AllowTelemetry",
      "Value": 1,
      "Type": "DWord"
    },
    {
      "Description": "Disable Cortana",
      "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Search",
      "Name": "AllowCortana",
      "Value": 0,
      "Type": "DWord"
    },
    {
      "Description": "Disable activity history being sent to Microsoft",
      "Path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System",
      "Name": "PublishUserActivities",
      "Value": 0,
      "Type": "DWord"
    },
    {
      "Description": "Disable tailored experiences based on diagnostic data",
      "Path": "HKCU:\\Software\\Policies\\Microsoft\\Windows\\CloudContent",
      "Name": "DisableTailoredExperiencesWithDiagnosticData",
      "Value": 1,
      "Type": "DWord"
    }
  ]
}